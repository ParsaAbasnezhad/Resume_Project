
<main>

    <!-- =========================================================
         PAGE HERO
    ========================================================== -->
    <section class="page-hero">
        <div class="page-hero__glow" aria-hidden="true"></div>
        <div class="container">
            <nav class="breadcrumb" aria-label="Breadcrumb">
                <a href="../index.html">Home</a>
                <span aria-hidden="true">/</span>
                <span aria-current="page">Projects</span>
            </nav>
            <h1 class="page-hero__title" data-reveal>Projects We've<br>Provided Liquidity For</h1>
            <p class="page-hero__subtitle" data-reveal>
                A running list of the token projects and exchanges our desk has supported —
                filter by category to browse the kind of markets we work in. Figures shown are
                illustrative examples of typical program outcomes.
            </p>
        </div>
    </section>

    <!-- =========================================================
         PROJECTS LIST
    ========================================================== -->
    <section class="showcase" id="projects-list">
        <div class="container">

            <!-- Category filter — JS toggles [data-category] cards below -->
            <div class="filter-bar" data-filter-bar role="group" aria-label="Filter projects by category">
                <button class="filter-btn is-active" data-filter="all" aria-pressed="true">All</button>
                <button class="filter-btn" data-filter="layer-1" aria-pressed="false">Layer 1</button>
                <button class="filter-btn" data-filter="dex" aria-pressed="false">DEX / AMM</button>
                <button class="filter-btn" data-filter="gamefi" aria-pressed="false">GameFi</button>
                <button class="filter-btn" data-filter="payments" aria-pressed="false">Payments</button>
                <button class="filter-btn" data-filter="nft" aria-pressed="false">NFT</button>
                <button class="filter-btn" data-filter="exchange" aria-pressed="false">Exchanges</button>
            </div>

            <p class="filter-empty" data-filter-empty hidden>No projects in this category yet — try another filter.</p>

            <ul class="glass-grid" data-filter-grid>
                {{#if projects}}
                    {{#each projects}}
                        <li class="glass-card" data-reveal data-category="{{this.category}}">
                            <span class="glass-card__index">{{index}}</span>
                            <h3 class="glass-card__name">{{this.name}}</h3>
                            <p class="glass-card__desc">{{this.first_description}}</p>
                        </li>
                    {{/each}}
                {{else}}
                    <li>No projects available at this time.</li>
                {{/if}}
            </ul>
        </div>
    </section>

    <!-- =========================================================
         CONTACT (reused component)
    ========================================================== -->
    <section class="contact" id="contact">
        <div class="contact__glow" aria-hidden="true"></div>
        <div class="container">
            <div class="section-heading">
                <h2 class="section-heading__title">Don't See Your Category?</h2>
                <p class="section-heading__text">
                    We work across most crypto-native asset types. Reach out and we'll tell you
                    honestly whether we're a fit for your market.
                </p>
                <a href="mailto:hello@gravityteam.co" class="btn btn--primary">Get In Touch</a>
                <p class="section-heading__alt-link">
                    or <a href="contact.html" class="link-arrow link-arrow--underline">leave your number and we'll call you</a>
                </p>
            </div>
        </div>
    </section>

</main>

